rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 경기 데이터: 로그인 없이 조회 가능, 클라이언트 쓰기 금지
    // Public match summaries; clients cannot write. Pages are bounded.
    match /matchSeries/{seriesId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 10;
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 데이터: 별도 권한을 설계하기 전까지 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}